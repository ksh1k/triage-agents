# Copy this file to .env and fill in your key. .env is gitignored and is never committed.
# Create a Gemini API key on the API Keys page in Google AI Studio.
GOOGLE_API_KEY=

# Optional: which Gemini model the agents use (default: gemini-3.5-flash-lite).
# gemini-3.8-flash is stronger but costs more and was overloaded (503/504) when tested.
TRIAGE_MODEL=gemini-3.5-flash-lite
